{
  "name": "fpl-draft-league",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "run-locally": "bash scripts/run-locally",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s scripts -p \"test_*.py\" -b",
    "db:stage": "node scripts/supabase-migrations.mjs stage supabase/.staged --fresh",
    "test:db": "npm run db:stage && supabase test db --workdir supabase/.staged",
    "e2e": "playwright test",
    "settle:higher-lower": "tsx scripts/higher-lower-settlement.ts",
    "audit:season-end-legacy": "tsx scripts/audit-season-end-legacy.ts",
    "refresh:higher-lower": "tsx scripts/refresh-higher-lower.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "register:discord-commands": "tsx scripts/register-discord-commands.ts",
    "simulate:packs": "tsx scripts/simulate-packs.ts",
    "simulate:season-end": "tsx scripts/simulate-season-end.ts",
    "export:drafts": "tsx scripts/export-drafts.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
