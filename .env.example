NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase status>
# Canonical public origin of the deployed site (no trailing slash), e.g.
# https://fpl.example.com — auth redirects are pinned to it so users who
# arrive via a *.vercel.app deployment link still land back on the real
# domain after Discord sign-in. Optional locally (falls back to the
# current origin).
NEXT_PUBLIC_SITE_URL=

# Used by scripts/riot_stats_ingest.py (Riot API stats ingester) only.
# Riot Developer Portal API key. Regenerate at https://developer.riotgames.com/
# if you suspect it has ever been exposed (e.g. committed to git history).
RIOT_API_KEY=
# Same Supabase project as above, but the ingester writes via the service
# role key (bypasses RLS) rather than the anon key, so it needs its own URL.
SUPABASE_URL=http://127.0.0.1:54321
# Service role key from `supabase status` (local) or the Supabase dashboard
# (production). NEVER commit this value or expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase status>

# Twitch API credentials used server-side to decide whether the FPL channel
# is live. Keep the secret server-only and do not prefix it with NEXT_PUBLIC_.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
